# 两个 API Key 必须不同，且长度不少于 24 个字符。
# 可运行 `python src/init_env.py` 自动生成安全随机值。
COOKIE_UPLOAD_API_KEY=replace-with-cookie-upload-api-key
SEARCH_API_KEY=replace-with-search-api-key

# 必须使用 Fernet.generate_key() 生成，不能自行填写普通字符串。
COOKIE_ENCRYPTION_KEY=replace-with-fernet-key

# SQLite
DATABASE_PATH=data/image-search.db

# Worker 与队列
UPLOAD_WORKER_COUNT=2
PRODUCT_WORKER_COUNT=2
MAX_QUEUED_TASKS=100
UPLOAD_TASK_TIMEOUT_SECONDS=240
PRODUCT_TASK_TIMEOUT_SECONDS=180
TASK_RETENTION_SECONDS=86400

# 远程图片下载
DOWNLOAD_CONNECT_TIMEOUT=10
DOWNLOAD_TIMEOUT=30
MAX_IMAGE_BYTES=8388608

# 1688 协议请求
SEARCH_HTTP_TIMEOUT=90
SEARCH_NETWORK_RETRIES=1
SEARCH_READY_RETRIES=8
SEARCH_READY_INTERVAL=1.5

# 商品 SKU 查询（v1/v2 共用，与图搜 Worker 无关）
# 并发槽位默认 2，允许 1～8；可先调整为 4。等待启动也占槽，满额返回 429。
SKU_MAX_CONCURRENCY=2
# 单次上游请求超时，单位秒，必须大于 0 且不超过 120。
SKU_HTTP_TIMEOUT=20
# 接口等待超时，单位秒，必须为有限正数，包含等待启动的时间。
SKU_QUERY_TIMEOUT_SECONDS=90
# 相邻查询启动间隔目前固定为随机 2～4 秒，不能通过环境变量调整。
# 修改配置后须重启现有 API 进程；系统环境中的同名变量优先。

# HTTP 服务
API_HOST=127.0.0.1
API_PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=INFO
