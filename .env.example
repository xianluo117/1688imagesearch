# 两个 API Key 必须不同，且长度不少于 24 个字符。
# 可运行 `python src/init_env.py` 自动生成安全随机值。
COOKIE_UPLOAD_API_KEY=replace-with-cookie-upload-api-key
SEARCH_API_KEY=replace-with-search-api-key

# 必须使用 Fernet.generate_key() 生成，不能自行填写普通字符串。
COOKIE_ENCRYPTION_KEY=replace-with-fernet-key

# SQLite
DATABASE_PATH=data/image-search.db

# 统一队列：图片上传、图搜商品查询、SKU 共用；仅支持单进程。
# 全局配置是唯一调度权威；任务并发范围 1～32。
GLOBAL_WORKER_COUNT=1
# 所有实际 1688 请求共享启动间隔，含轮询、重试、令牌刷新和重定向。
# 单位秒，均须 >0 且 <=3600，最小值不得大于最大值。
REQUEST_INTERVAL_MIN_SECONDS=2
REQUEST_INTERVAL_MAX_SECONDS=4
# 限流冷却秒数，>0 且 <=86400；可信上游等待时间更长时遵守上游。
RATE_LIMIT_COOLDOWN_SECONDS=60
# 三类排队中 + 执行中总容量，范围 1～100000；不是每类容量。
MAX_QUEUED_TASKS=100
# 有效执行预算秒数，>0 且 <=86400；不含排队和请求入口的保护等待。
# 正常间隔等待、下载和在途网络时间仍计入；超时不提前释放在途槽位。
UPLOAD_TASK_TIMEOUT_SECONDS=240
PRODUCT_TASK_TIMEOUT_SECONDS=180
SKU_TASK_TIMEOUT_SECONDS=180
# 终态后保留秒数；每小时清理，依赖可能延长保留；幂等键随任务清理。
TASK_RETENTION_SECONDS=86400

# 已弃用：仅兼容读取并校验，不影响全局默认并发 1，不叠加限速。
# 建议删除旧部署中的这些变量；保留时上传/图搜须为 1～2，SKU 须为 1～8。
# UPLOAD_WORKER_COUNT=2
# PRODUCT_WORKER_COUNT=2
# SKU_MAX_CONCURRENCY=2

# 远程图片下载
DOWNLOAD_CONNECT_TIMEOUT=10
DOWNLOAD_TIMEOUT=30
MAX_IMAGE_BYTES=8388608

# 1688 协议请求
SEARCH_HTTP_TIMEOUT=90
SEARCH_NETWORK_RETRIES=1
SEARCH_READY_RETRIES=8
SEARCH_READY_INTERVAL=1.5

# SKU 同步两版和异步接口共用统一队列。
# 单次上游请求超时秒数，必须大于 0 且不超过 120，不等于执行预算。
SKU_HTTP_TIMEOUT=20
# 同步 HTTP 入队后等待秒数，有限正数，包含排队和保护等待。
# 超时返回 504、任务 ID 和查询位置；后台继续，断开也不取消任务。
SKU_QUERY_TIMEOUT_SECONDS=90
# 暂停持久化；更新 Cookie 或重启不自动恢复，须调用人工恢复接口。
# 调速不能保证避免验证码。修改配置需人工停旧进程后单进程启动；禁止新旧消费者共跑。
# 系统环境中的同名变量优先；完整语义见 docs/unified-queue.md。

# HTTP 服务
API_HOST=127.0.0.1
API_PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=INFO
